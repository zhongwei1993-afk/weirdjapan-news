---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImageUrl,
	heroImageAlt,
	heroImageCredit,
	heroImageCreditUrl,
	category,
} = Astro.props;

const sealForCategory: Record<string, string> = {
	'Only In Japan': '奇',
	'Tech': '機',
	'Tech & Culture': '機',
	'Food': '食',
	'Culture': '禮',
	'Lifestyle': '生',
	'Tokyo': '都',
	'Travel Guide': '旅',
	'About': '報',
};
const seal = sealForCategory[category] || '記';
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImageUrl}
			type="article"
			publishedTime={pubDate}
			modifiedTime={updatedDate}
			tags={[category]}
		/>
	</head>

	<body>
		<Header />

		<article class="article">
			<header class="article-header">
				<div class="article-header-inner">
					<a href="/blog" class="back-link">← All dispatches</a>
					<div class="meta-row">
						<span class="seal" aria-hidden="true">{seal}</span>
						<span class="kicker">{category}</span>
						<span class="sep">/</span>
						<span class="date"><FormattedDate date={pubDate} /></span>
						{updatedDate && (
							<>
								<span class="sep">/</span>
								<span class="updated">revised <FormattedDate date={updatedDate} /></span>
							</>
						)}
					</div>
					<h1>{title}</h1>
					<p class="lede">{description}</p>
					<div class="article-byline">
						<span class="byline-seal seal" aria-hidden="true">編</span>
						<span>By <strong>WeirdJapan Editorial</strong></span>
					</div>
				</div>
			</header>

			{heroImageUrl && (
				<figure class="article-hero-figure">
					<img
						src={heroImageUrl}
						alt={heroImageAlt || title}
						class="article-hero-img"
						loading="eager"
						fetchpriority="high"
						width="1280"
						height="720"
					/>
					{heroImageCredit && (
						<figcaption class="article-hero-credit">
							{heroImageCreditUrl ? (
								<a href={heroImageCreditUrl} target="_blank" rel="noopener">{heroImageCredit}</a>
							) : (
								<span>{heroImageCredit}</span>
							)}
						</figcaption>
					)}
				</figure>
			)}

			<div class="article-body prose">
				<slot />
			</div>

			<footer class="article-footer">
				<div class="share">
					<span class="share-label">Share</span>
					<a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${Astro.url}`} target="_blank" rel="noopener" aria-label="Share on X">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
					</a>
					<a href={`https://www.facebook.com/sharer/sharer.php?u=${Astro.url}`} target="_blank" rel="noopener" aria-label="Share on Facebook">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg>
					</a>
					<a href={`https://www.reddit.com/submit?url=${Astro.url}&title=${encodeURIComponent(title)}`} target="_blank" rel="noopener" aria-label="Share on Reddit">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12.5c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/></svg>
					</a>
				</div>

				<div class="newsletter-inline">
					<span class="inline-seal seal" aria-hidden="true">報</span>
					<h3>Dispatches from Weird Japan</h3>
					<p>Three weird Japan discoveries, one travel tip, one Amazon find. Every Sunday. Free.</p>
					<form
						class="newsletter-form-inline"
						action="https://dispatchesfromweirdjapan.substack.com/api/v1/free?nojs=true"
						method="post"
						target="_top"
					>
						<input type="email" name="email" placeholder="your@email.com" aria-label="Email address" required />
						<input type="hidden" name="first_url" value={Astro.url.toString()} />
						<input type="hidden" name="current_url" value={Astro.url.toString()} />
						<input type="hidden" name="source" value="weirdjapan_blogpost_footer" />
						<button type="submit">Subscribe →</button>
					</form>
				</div>
			</footer>
		</article>

		<Footer />

		<style>
			.article {
				background: transparent;
			}

			.article-header {
				padding: 2.5em 1.5em 0.5em;
				border-bottom: 4px double rgb(var(--ink));
			}
			.article-header-inner {
				max-width: 760px;
				margin: 0 auto;
			}
			.back-link {
				display: inline-block;
				font-family: var(--font-mincho);
				font-size: 0.78rem;
				color: rgb(var(--ink-soft));
				text-decoration: none;
				border: none;
				margin-bottom: 1.4em;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				transition: color 150ms ease;
			}
			.back-link:hover { color: rgb(var(--vermilion)); border: none; }

			.meta-row {
				display: flex;
				align-items: center;
				gap: 0.6em;
				margin-bottom: 1em;
				font-family: var(--font-mincho);
				font-size: 0.78rem;
				color: rgb(var(--ink-faint));
			}
			.kicker {
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.14em;
				color: rgb(var(--vermilion));
			}
			.sep { color: rgb(var(--rule)); }
			.date, .updated {
				font-family: var(--font-accent);
				letter-spacing: 0.04em;
			}

			.article-header h1 {
				font-family: var(--font-display);
				font-size: clamp(2.4rem, 5vw, 3.6rem);
				line-height: 1.05;
				margin: 0 0 0.5em;
				letter-spacing: -0.025em;
				color: rgb(var(--ink));
			}

			.lede {
				font-family: var(--font-display);
				font-size: 1.35rem;
				line-height: 1.5;
				color: rgb(var(--ink-soft));
				margin: 0 0 1.5em;
				font-style: italic;
			}

			.article-byline {
				display: inline-flex;
				align-items: center;
				gap: 0.6em;
				padding: 0.8em 0 1.5em;
				font-family: var(--font-mincho);
				font-size: 0.9rem;
				color: rgb(var(--ink-soft));
			}
			.byline-seal {
				font-size: 0.5em;
			}
			.article-byline strong {
				color: rgb(var(--ink));
				font-weight: 600;
			}

			.article-hero-figure {
				max-width: var(--container);
				margin: 2em auto 0;
				padding: 0 1.5em;
			}
			.article-hero-img {
				width: 100%;
				aspect-ratio: 16 / 9;
				object-fit: cover;
				display: block;
				background: rgb(var(--washi-deep));
				border: 1px solid rgba(26, 26, 26, 0.2);
				filter: contrast(0.92) saturate(0.85) sepia(0.06);
			}
			.article-hero-credit {
				text-align: right;
				font-family: var(--font-accent);
				font-size: 0.72rem;
				color: rgb(var(--ink-faint));
				margin-top: 0.5em;
				padding-right: 0.2em;
				letter-spacing: 0.02em;
			}
			.article-hero-credit a {
				color: inherit;
				border: none;
			}
			.article-hero-credit a:hover {
				color: rgb(var(--vermilion));
				border: none;
			}

			.article-body.prose {
				max-width: 720px;
				margin: 3em auto;
				padding: 0 1.5em;
				font-family: var(--font-body);
				font-size: 1.1rem;
				line-height: 1.75;
				color: rgb(var(--ink));
			}

			/* Dropcap on the first paragraph of the article */
			.article-body.prose :global(p:first-of-type) {
				font-size: 1.18rem;
				line-height: 1.65;
				color: rgb(var(--ink));
			}
			.article-body.prose :global(p:first-of-type::first-letter) {
				font-family: var(--font-display);
				font-size: 4.5rem;
				font-weight: 400;
				color: rgb(var(--vermilion));
				float: left;
				line-height: 0.85;
				padding: 0.18em 0.12em 0.05em 0;
				margin-right: 0.04em;
				font-style: normal;
			}

			.article-body.prose :global(h2) {
				font-family: var(--font-display);
				font-size: 2rem;
				margin-top: 2.2em;
				margin-bottom: 0.5em;
				padding-top: 0.6em;
				border-top: 1px solid rgb(var(--ink));
				position: relative;
				color: rgb(var(--ink));
			}
			.article-body.prose :global(h2)::before {
				content: '◉';
				position: absolute;
				top: 0;
				left: 0;
				transform: translateY(-50%);
				background: rgb(var(--washi));
				padding-right: 0.3em;
				color: rgb(var(--vermilion));
				font-size: 0.5em;
			}
			.article-body.prose :global(h3) {
				font-family: var(--font-display);
				font-size: 1.45rem;
				margin-top: 1.8em;
			}
			.article-body.prose :global(blockquote) {
				border: none;
				border-top: 2px solid rgb(var(--ink));
				border-bottom: 2px solid rgb(var(--ink));
				padding: 1em 0;
				margin: 2em 0;
				font-family: var(--font-display);
				font-size: 1.45rem;
				font-style: italic;
				line-height: 1.45;
				color: rgb(var(--ink-soft));
				text-align: center;
				position: relative;
			}
			.article-body.prose :global(blockquote)::before {
				content: '◉';
				display: block;
				color: rgb(var(--vermilion));
				font-size: 0.5em;
				font-style: normal;
				margin-bottom: 0.3em;
			}
			.article-body.prose :global(ul li),
			.article-body.prose :global(ol li) {
				margin-bottom: 0.45em;
			}
			.article-body.prose :global(table) {
				font-size: 0.95em;
			}
			.article-body.prose :global(hr) {
				margin: 3em auto;
				height: 5px;
				border: none;
				background-image:
					linear-gradient(to right, rgb(var(--ink)), rgb(var(--ink))),
					linear-gradient(to right, rgb(var(--ink)), rgb(var(--ink)));
				background-size: 100% 2px, 100% 1px;
				background-position: 0 0, 0 100%;
				background-repeat: no-repeat;
				position: relative;
			}
			.article-body.prose :global(hr)::after {
				content: '◆';
				position: absolute;
				top: -10px;
				left: 50%;
				transform: translateX(-50%);
				background: rgb(var(--washi));
				padding: 0 0.6em;
				color: rgb(var(--vermilion));
				font-size: 0.85em;
			}
			.article-body.prose :global(img) {
				width: 100%;
				margin: 2em 0 0.5em;
				display: block;
				border: 1px solid rgba(26, 26, 26, 0.15);
				filter: contrast(0.92) saturate(0.85) sepia(0.06);
			}
			.article-body.prose :global(img + em),
			.article-body.prose :global(p > img + em) {
				display: block;
				text-align: center;
				font-family: var(--font-accent);
				font-size: 0.78rem;
				color: rgb(var(--ink-faint));
				margin: 0 0 2em;
				font-style: normal;
				letter-spacing: 0.02em;
			}
			.article-body.prose :global(p:has(> img)) {
				margin-bottom: 0;
			}

			/* Footer */
			.article-footer {
				max-width: 720px;
				margin: 3em auto;
				padding: 0 1.5em;
			}
			.share {
				display: flex;
				align-items: center;
				gap: 0.8em;
				padding: 1.5em 0;
				border-top: 1px solid rgb(var(--ink));
				border-bottom: 1px solid rgb(var(--ink));
				margin-bottom: 3em;
			}
			.share-label {
				font-family: var(--font-mincho);
				font-size: 0.78rem;
				text-transform: uppercase;
				letter-spacing: 0.14em;
				font-weight: 600;
				color: rgb(var(--vermilion));
				margin-right: 0.5em;
			}
			.share a {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 36px;
				height: 36px;
				border: 1px solid rgb(var(--ink));
				border-radius: 0;
				color: rgb(var(--ink));
				transition: all 150ms ease;
				background: transparent;
				border-bottom: 1px solid rgb(var(--ink));
			}
			.share a:hover {
				background: rgb(var(--vermilion));
				border-color: rgb(var(--vermilion));
				color: rgb(var(--washi));
			}

			.newsletter-inline {
				position: relative;
				background: rgb(var(--washi-deep));
				border: 2px solid rgb(var(--ink));
				padding: 2.4em 2em 2em;
				text-align: center;
			}
			.inline-seal {
				position: absolute;
				top: -1.4em;
				left: 50%;
				transform: translateX(-50%) rotate(-5deg);
				font-size: 0.8em;
			}
			.newsletter-inline h3 {
				margin: 0.2em 0 0.3em;
				font-family: var(--font-display);
				font-size: 1.6rem;
				color: rgb(var(--ink));
				letter-spacing: -0.012em;
			}
			.newsletter-inline p {
				margin: 0 0 1.2em;
				color: rgb(var(--ink-soft));
				font-size: 0.95rem;
				font-family: var(--font-display);
				font-style: italic;
			}
			.newsletter-form-inline {
				display: flex;
				gap: 0;
				max-width: 420px;
				margin: 0 auto;
				border: 1px solid rgb(var(--ink));
			}
			.newsletter-form-inline input {
				flex: 1;
				padding: 0.75em 0.9em;
				border: none;
				background: rgb(var(--washi));
				font-family: var(--font-body);
				font-size: 0.94rem;
				color: rgb(var(--ink));
			}
			.newsletter-form-inline input::placeholder {
				color: rgb(var(--ink-faint));
				font-style: italic;
			}
			.newsletter-form-inline button {
				padding: 0.75em 1.2em;
				background: rgb(var(--ink));
				color: rgb(var(--washi));
				border: none;
				font-family: var(--font-mincho);
				font-weight: 600;
				cursor: pointer;
				transition: background 150ms ease;
				font-size: 0.88rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
			}
			.newsletter-form-inline button:hover { background: rgb(var(--vermilion)); }

			@media (max-width: 720px) {
				.article-header { padding: 1.5em 1em 0.5em; }
				.article-header h1 { font-size: 2.1rem; }
				.lede { font-size: 1.15rem; }
				.article-hero-figure { padding: 0 1em; }
				.article-body.prose { padding: 0 1em; font-size: 1.05rem; }
				.article-body.prose :global(p:first-of-type::first-letter) { font-size: 3.4rem; }
				.article-body.prose :global(h2) { font-size: 1.6rem; }
				.newsletter-form-inline { flex-direction: column; }
			}
		</style>
	</body>
</html>
