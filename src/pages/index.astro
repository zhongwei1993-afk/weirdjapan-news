---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [hero, ...allRest] = posts;
const featured = allRest.slice(0, 2);
const rest = allRest.slice(2, 14);
const totalCount = posts.length;

// "Seal" character for each category — picks a single kanji
const sealForCategory: Record<string, string> = {
	'Only In Japan': '奇',
	'Tech': '機',
	'Tech & Culture': '機',
	'Food': '食',
	'Culture': '禮',
	'Lifestyle': '生',
	'Tokyo': '都',
	'Travel Guide': '旅',
};
function seal(category: string): string {
	return sealForCategory[category] || '記';
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		{hero && (
			<section class="hero">
				<div class="hero-grid">
					<a href={`/blog/${hero.id}/`} class="hero-main">
						<div class="hero-meta">
							<span class="seal" aria-hidden="true">{seal(hero.data.category)}</span>
							<div>
								<span class="hero-kicker">Today's Front Page &middot; {hero.data.category}</span>
								<span class="hero-date"><FormattedDate date={hero.data.pubDate} /></span>
							</div>
						</div>
						<h1 class="hero-title">{hero.data.title}</h1>
						<p class="hero-lede">{hero.data.description}</p>
						<div class="hero-image-wrap">
							{hero.data.heroImageUrl && (
								<img src={hero.data.heroImageUrl} alt={hero.data.heroImageAlt || hero.data.title} class="hero-img" loading="eager" fetchpriority="high" width="900" height="600" />
							)}
							{hero.data.heroImageCredit && (
								<span class="hero-credit">{hero.data.heroImageCredit}</span>
							)}
						</div>
						<span class="hero-cta">Continue reading →</span>
					</a>

					<aside class="hero-side">
						<div class="side-header">
							<span class="side-label">Also On Today's Page</span>
							<div class="edo-rule"></div>
						</div>
						{featured.map((post) => (
							<article class="side-article">
								<a href={`/blog/${post.id}/`} class="side-link">
									<span class="side-kicker">{post.data.category}</span>
									<h3 class="side-title">{post.data.title}</h3>
									<p class="side-desc">{post.data.description}</p>
									<FormattedDate date={post.data.pubDate} />
								</a>
							</article>
						))}
					</aside>
				</div>
			</section>
		)}

		<section class="latest-section">
			<div class="section-header">
				<h2 class="section-title">
					<span class="section-seal seal" aria-hidden="true">続</span>
					More from the Gazette
				</h2>
				<a href="/blog" class="section-link">Read all {totalCount} dispatches →</a>
			</div>
			<div class="edo-rule"></div>

			{rest.length === 0 ? (
				<p class="empty">More stories arrive each morning. Subscribe below.</p>
			) : (
				<div class="grid">
					{rest.map((post) => (
						<article class="card">
							<a href={`/blog/${post.id}/`} class="card-link">
								<div class="card-image">
									{post.data.heroImageUrl ? (
										<img src={post.data.heroImageUrl} alt={post.data.heroImageAlt || post.data.title} class="card-img" loading="lazy" width="600" height="450" />
									) : (
										<div class="card-pattern" aria-hidden="true"></div>
									)}
								</div>
								<div class="card-body">
									<div class="card-meta-row">
										<span class="seal card-seal" aria-hidden="true">{seal(post.data.category)}</span>
										<span class="card-kicker">{post.data.category}</span>
									</div>
									<h3 class="card-title">{post.data.title}</h3>
									<p class="card-desc">{post.data.description}</p>
									<FormattedDate date={post.data.pubDate} />
								</div>
							</a>
						</article>
					))}
				</div>
			)}
		</section>

		<section class="newsletter">
			<div class="newsletter-inner">
				<span class="newsletter-stamp seal" aria-hidden="true">報</span>
				<h2>The Weekly Weird</h2>
				<p>Five strange Japan dispatches every Sunday morning. No spam. Unsubscribe whenever.</p>
				<form class="newsletter-form" onsubmit="event.preventDefault();">
					<input type="email" placeholder="your@email.com" aria-label="Email address" required />
					<button type="submit">Subscribe →</button>
				</form>
			</div>
		</section>

		<Footer />

		<style>
			/* Hero — broadsheet style: large lead story on left, two side pieces on right */
			.hero {
				max-width: var(--container);
				margin: 1.5em auto 0;
				padding: 0 1.5em;
			}
			.hero-grid {
				display: grid;
				grid-template-columns: 1.7fr 1fr;
				gap: 2.5em;
				padding-top: 1.5em;
				border-top: 4px solid rgb(var(--ink));
				border-top-style: double;
			}

			/* Main lead story */
			.hero-main {
				display: block;
				color: inherit;
				text-decoration: none;
				border: none;
			}
			.hero-meta {
				display: flex;
				align-items: center;
				gap: 0.8em;
				margin-bottom: 1em;
			}
			.hero-meta > div {
				display: flex;
				flex-direction: column;
				gap: 0.15em;
			}
			.hero-kicker {
				font-family: var(--font-mincho);
				font-size: 0.78rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.14em;
				color: rgb(var(--vermilion));
			}
			.hero-date {
				font-family: var(--font-accent);
				font-size: 0.75rem;
				color: rgb(var(--ink-faint));
				letter-spacing: 0.05em;
			}
			.hero-title {
				font-family: var(--font-display);
				font-size: clamp(2.4rem, 5vw, 4rem);
				line-height: 1.05;
				margin: 0 0 0.4em;
				letter-spacing: -0.02em;
				color: rgb(var(--ink));
				transition: color 200ms ease;
			}
			.hero-main:hover .hero-title { color: rgb(var(--vermilion-deep)); }
			.hero-lede {
				font-family: var(--font-display);
				font-style: italic;
				font-size: 1.25rem;
				line-height: 1.45;
				color: rgb(var(--ink-soft));
				margin: 0 0 1.4em;
				max-width: 38em;
			}
			.hero-image-wrap {
				position: relative;
				margin: 0 0 1em;
			}
			.hero-img {
				width: 100%;
				aspect-ratio: 3 / 2;
				object-fit: cover;
				display: block;
				border: 1px solid rgba(26, 26, 26, 0.15);
				filter: contrast(0.92) saturate(0.85) sepia(0.06);
			}
			.hero-credit {
				display: block;
				font-family: var(--font-accent);
				font-size: 0.7rem;
				color: rgb(var(--ink-faint));
				margin-top: 0.4em;
				text-align: right;
				letter-spacing: 0.02em;
			}
			.hero-cta {
				font-family: var(--font-mincho);
				font-size: 0.9rem;
				color: rgb(var(--vermilion));
				font-weight: 600;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			/* Side column */
			.hero-side {
				border-left: 1px solid rgb(var(--rule));
				padding-left: 2em;
			}
			.side-header {
				margin-bottom: 1em;
			}
			.side-label {
				display: block;
				font-family: var(--font-mincho);
				font-size: 0.7rem;
				text-transform: uppercase;
				letter-spacing: 0.2em;
				color: rgb(var(--vermilion));
				margin-bottom: 0.4em;
			}
			.side-header .edo-rule {
				height: 4px;
				background-size: 100% 2px, 100% 1px;
				margin: 0;
			}
			.side-article {
				padding: 1.4em 0;
				border-bottom: 1px solid rgb(var(--rule));
			}
			.side-article:last-child { border-bottom: none; }
			.side-link {
				display: block;
				color: inherit;
				text-decoration: none;
				border: none;
			}
			.side-kicker {
				display: block;
				font-family: var(--font-mincho);
				font-size: 0.68rem;
				text-transform: uppercase;
				letter-spacing: 0.16em;
				color: rgb(var(--vermilion));
				margin-bottom: 0.4em;
			}
			.side-title {
				font-family: var(--font-display);
				font-size: 1.35rem;
				line-height: 1.2;
				margin: 0 0 0.4em;
				color: rgb(var(--ink));
				transition: color 180ms ease;
			}
			.side-link:hover .side-title { color: rgb(var(--vermilion-deep)); }
			.side-desc {
				font-family: var(--font-body);
				font-size: 0.92rem;
				color: rgb(var(--ink-soft));
				line-height: 1.5;
				margin: 0 0 0.6em;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.side-link :global(time) {
				font-family: var(--font-accent);
				font-size: 0.72rem;
				color: rgb(var(--ink-faint));
			}

			/* Latest section grid */
			.latest-section {
				max-width: var(--container);
				margin: 4em auto;
				padding: 0 1.5em;
			}
			.section-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1em;
				margin-bottom: 0.4em;
			}
			.section-title {
				display: inline-flex;
				align-items: center;
				gap: 0.5em;
				font-family: var(--font-display);
				font-size: 1.9rem;
				margin: 0;
				font-weight: 400;
				letter-spacing: -0.014em;
			}
			.section-seal { font-size: 0.55em; }
			.section-link {
				font-family: var(--font-mincho);
				font-size: 0.78rem;
				color: rgb(var(--ink-soft));
				border: none;
				text-decoration: none;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				font-weight: 500;
			}
			.section-link:hover {
				color: rgb(var(--vermilion));
				border: none;
			}

			.latest-section .edo-rule {
				margin: 0 0 2em;
			}

			.grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 2.5em 2em;
			}
			.empty {
				text-align: center;
				padding: 3em 0;
				color: rgb(var(--ink-faint));
				font-style: italic;
				font-family: var(--font-display);
			}

			.card-link {
				display: block;
				color: inherit;
				text-decoration: none;
				border: none;
			}
			.card-image {
				aspect-ratio: 4 / 3;
				background: rgb(var(--washi-deep));
				overflow: hidden;
				margin-bottom: 0.9em;
				position: relative;
				border: 1px solid rgba(26, 26, 26, 0.15);
			}
			.card-img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				filter: contrast(0.92) saturate(0.85) sepia(0.06);
				transition: filter 280ms ease, transform 320ms ease;
			}
			.card-link:hover .card-img {
				filter: contrast(0.98) saturate(0.95);
				transform: scale(1.02);
			}
			.card-pattern {
				position: absolute;
				inset: 0;
				background-image:
					repeating-linear-gradient(0deg, transparent 0, transparent 8px, rgba(26, 26, 26, 0.04) 8px, rgba(26, 26, 26, 0.04) 9px);
			}
			.card-meta-row {
				display: flex;
				align-items: center;
				gap: 0.5em;
				margin-bottom: 0.4em;
			}
			.card-seal {
				font-size: 0.45em;
				transform: rotate(-3deg);
			}
			.card-kicker {
				font-family: var(--font-mincho);
				font-size: 0.68rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.14em;
				color: rgb(var(--vermilion));
			}
			.card-title {
				font-family: var(--font-display);
				font-size: 1.35rem;
				margin: 0 0 0.4em;
				line-height: 1.2;
				color: rgb(var(--ink));
				transition: color 180ms ease;
			}
			.card-link:hover .card-title { color: rgb(var(--vermilion-deep)); }
			.card-desc {
				font-family: var(--font-body);
				font-size: 0.94rem;
				color: rgb(var(--ink-soft));
				line-height: 1.5;
				margin: 0 0 0.6em;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.card-body :global(time) {
				font-family: var(--font-accent);
				font-size: 0.72rem;
				color: rgb(var(--ink-faint));
				letter-spacing: 0.04em;
			}

			/* Newsletter — like a subscription form clipping in an old paper */
			.newsletter {
				background: rgb(var(--ink));
				color: rgb(var(--washi));
				padding: 4em 1.5em 4.5em;
				margin-top: 5em;
				position: relative;
				border-top: 1px solid rgba(255, 240, 220, 0.1);
				border-bottom: 1px solid rgba(255, 240, 220, 0.1);
			}
			.newsletter::before {
				content: '';
				position: absolute;
				inset: 0;
				background-image:
					repeating-linear-gradient(45deg, transparent 0, transparent 12px, rgba(245, 239, 224, 0.025) 12px, rgba(245, 239, 224, 0.025) 13px);
				pointer-events: none;
			}
			.newsletter-inner {
				max-width: 560px;
				margin: 0 auto;
				text-align: center;
				position: relative;
			}
			.newsletter-stamp {
				position: absolute;
				top: -2.2em;
				left: 50%;
				transform: translateX(-50%) rotate(-6deg);
				font-size: 1em;
				background: rgb(var(--vermilion));
				color: rgb(var(--washi));
				box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.4), inset 0 0 0 2px rgba(255, 240, 220, 0.22);
			}
			.newsletter h2 {
				color: rgb(var(--washi));
				margin: 0.4em 0 0.3em;
				font-size: 2.2rem;
				font-family: var(--font-display);
				letter-spacing: -0.018em;
			}
			.newsletter p {
				color: rgba(245, 239, 224, 0.7);
				margin: 0 0 1.6em;
				font-size: 1rem;
				font-family: var(--font-display);
				font-style: italic;
			}
			.newsletter-form {
				display: flex;
				gap: 0;
				max-width: 460px;
				margin: 0 auto;
				border: 1px solid rgba(245, 239, 224, 0.4);
			}
			.newsletter-form input {
				flex: 1;
				padding: 0.95em 1em;
				border: none;
				background: transparent;
				color: rgb(var(--washi));
				font-family: var(--font-body);
				font-size: 0.95rem;
			}
			.newsletter-form input::placeholder {
				color: rgba(245, 239, 224, 0.4);
				font-style: italic;
			}
			.newsletter-form input:focus {
				outline: none;
				background: rgba(245, 239, 224, 0.06);
			}
			.newsletter-form button {
				padding: 0.95em 1.5em;
				background: rgb(var(--vermilion));
				color: rgb(var(--washi));
				border: none;
				font-family: var(--font-mincho);
				font-weight: 600;
				cursor: pointer;
				transition: background 150ms ease;
				font-size: 0.92rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
			}
			.newsletter-form button:hover { background: rgb(var(--vermilion-deep)); }

			@media (max-width: 960px) {
				.hero-grid {
					grid-template-columns: 1fr;
					gap: 2em;
				}
				.hero-side {
					border-left: none;
					border-top: 1px solid rgb(var(--rule));
					padding-left: 0;
					padding-top: 1.5em;
				}
				.grid { grid-template-columns: repeat(2, 1fr); }
			}
			@media (max-width: 640px) {
				.grid { grid-template-columns: 1fr; }
				.section-header {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.3em;
				}
				.section-title { font-size: 1.5rem; }
				.newsletter-form { flex-direction: column; }
			}
		</style>
	</body>
</html>
